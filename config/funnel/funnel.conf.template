# Funnel TES — https://github.com/ohsu-comp-bio/funnel
# Compute is driven by stack.yml services.tes.backend (local | slurm).
# See docs/SLURM-SETUP.md for login-node expectations.

Server:
  HostName: funnel
  RPCPort: "9090"
  HTTPPort: "8000"

Node:
  ID: funnel-node-1
  Resources:
    CPU: 1
    RAM: 1.0 GB
    Disk: 10.0 GB

Database:
  Path: /opt/funnel/funnel.db

Worker:
  WorkDir: /opt/funnel/work

Compute: {{ compute }}
{% if compute == "slurm" %}
Slurm:
  Partition: "{{ slurm_partition }}"
  Timelimit: "{{ slurm_timelimit }}"
{% endif %}

Docker:
  Endpoint: unix:///var/run/docker.sock
